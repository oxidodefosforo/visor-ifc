{
  "name": "visor-ifc",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "node tests/e2e.mjs",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.config.cjs",
    "release:win": "npm run build && electron-builder --win --x64 --config electron-builder.config.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "@types/three": "0.186.0",
    "camera-controls": "3.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.3",
    "iwer": "2.5.0",
    "playwright": "1.56.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "web-ifc": "0.0.77"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "web-ifc": "$web-ifc"
  },
  "productName": "Visor IFC",
  "description": "Visor IFC local para coordinación BIM",
  "author": "Juan",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxidodefosforo/visor-ifc.git"
  }
}
